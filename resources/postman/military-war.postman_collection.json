    {
      "name": "4. Batalla",
      "description": "Compara los puntos totales de dos ejércitos. El ganador recibe 100 de oro; el perdedor pierde su unidad más débil y 50 de oro. En empate, ambos pierden su unidad más débil.",
      "item": [
        {
          "name": "Simular batalla",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('El resultado es victory, defeat o draw', function () {",
                  "    pm.expect(body.result).to.be.oneOf(['victory', 'defeat', 'draw']);",
                  "});",
                  "",
                  "pm.test('En empate no hay ganador ni perdedor', function () {",
                  "    if (body.result === 'draw') {",
                  "        pm.expect(body.winnerId).to.be.null;",
                  "        pm.expect(body.loserId).to.be.null;",
                  "    } else {",
                  "        pm.expect(body.winnerId).to.be.a('string');",
                  "        pm.expect(body.loserId).to.be.a('string');",
                  "    }",
                  "});",
                  "",
                  "console.log('Resultado:', body.result);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstArmyId\": \"{{armyId}}\",\n  \"secondArmyId\": \"{{rivalArmyId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/battle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "battle"
              ]
            },
            "description": "El campo `result` siempre se expresa desde la perspectiva de `firstArmyId`.\n\nRequiere haber creado ambos ejércitos (carpeta 1) para que `armyId` y `rivalArmyId` estén definidos."
          },
          "response": []
        },
        {
          "name": "Consultar historial tras la batalla",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('La batalla quedó registrada en el historial', function () {",
                  "    pm.expect(pm.response.json().battleHistory).to.have.lengthOf.at.least(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/armies/{{armyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "armies",
                "{{armyId}}"
              ]
            },
            "description": "Comprueba el oro resultante, las unidades que sobrevivieron y la entrada añadida a `battleHistory`."
          },
          "response": []
        }
      ]
    },
