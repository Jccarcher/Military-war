        {
          "name": "Consultar ejército",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Devuelve el ejército solicitado', function () {",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('armyId'));",
                  "});",
                  "",
                  "pm.test('Incluye oro, unidades e historial', function () {",
                  "    pm.expect(body).to.have.property('gold');",
                  "    pm.expect(body.units).to.be.an('array');",
                  "    pm.expect(body.battleHistory).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/armies/{{armyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "armies",
                "{{armyId}}"
              ]
            },
            "description": "Devuelve el estado actual del ejército: oro, unidades con sus puntos y contador de entrenamientos, e historial de batallas."
          },
          "response": []
        }
      ]
